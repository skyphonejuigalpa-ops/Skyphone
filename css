/* =====================================================
   SKYPHONE
   ===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

:root {

    --turquesa: rgb(18, 184, 212);
    --turquesa-dark: rgb(12, 157, 184);

    --gris-oscuro: rgb(48, 55, 68);
    --gris-texto: rgb(95, 102, 115);

    --gris-claro: rgb(245, 247, 249);

    --blanco: #ffffff;
}

body {

    font-family: Arial, Helvetica, sans-serif;

    color: var(--gris-oscuro);

    background: white;

    line-height: 1.6;
}


/* =====================================================
   HEADER
   ===================================================== */

.header {

    height: 78px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 7%;

    background: rgba(255,255,255,0.95);

    border-bottom: 1px solid #eee;

    position: sticky;

    top: 0;

    z-index: 1000;
}


.logo,
.footer-logo {

    display: flex;

    align-items: center;

    gap: 10px;

    font-size: 25px;

    font-weight: 800;

    color: var(--gris-oscuro);
}


.logo span span,
.footer-logo span span {

    color: var(--turquesa);
}


.logo-icon {

    width: 40px;

    height: 40px;

    border-radius: 12px;

    background: var(--turquesa);

    display: flex;

    align-items: center;

    justify-content: center;

    color: white;

    font-size: 20px;
}


nav {

    display: flex;

    gap: 35px;
}


nav a {

    text-decoration: none;

    color: var(--gris-texto);

    font-size: 15px;

    font-weight: 600;

    transition: .3s;
}


nav a:hover {

    color: var(--turquesa);
}


.menu-btn {

    display: none;

    border: none;

    background: none;

    font-size: 25px;

    color: var(--gris-oscuro);

    cursor: pointer;
}


/* =====================================================
   HERO
   ===================================================== */

.hero {

    min-height: 650px;

    padding: 80px 8%;

    display: flex;

    align-items: center;

    justify-content: space-between;

    overflow: hidden;

    background:

        radial-gradient(
            circle at 80% 50%,
            rgba(18,184,212,.13),
            transparent 30%
        ),

        linear-gradient(
            135deg,
            #ffffff,
            #f6fbfc
        );
}


.hero-content {

    max-width: 600px;
}


.hero-tag {

    color: var(--turquesa-dark);

    font-weight: 700;

    font-size: 13px;

    letter-spacing: 2px;
}


.hero h1 {

    font-size: clamp(50px, 7vw, 82px);

    line-height: 1.05;

    margin: 18px 0;

    color: var(--gris-oscuro);
}


.hero h1 span {

    color: var(--turquesa);
}


.hero p {

    font-size: 18px;

    color: var(--gris-texto);

    max-width: 520px;

    margin-bottom: 30px;
}


.hero-buttons {

    display: flex;

    gap: 15px;
}


.btn {

    display: inline-block;

    padding: 13px 25px;

    border-radius: 10px;

    text-decoration: none;

    font-weight: 700;

    border: none;

    cursor: pointer;

    transition: .3s;
}


.btn.primary {

    background: var(--turquesa);

    color: white;

    box-shadow: 0 8px 25px rgba(18,184,212,.25);
}


.btn.primary:hover {

    background: var(--turquesa-dark);

    transform: translateY(-2px);
}


.btn.secondary {

    border: 1px solid #dce2e5;

    color: var(--gris-oscuro);

    background: white;
}


.btn.secondary:hover {

    border-color: var(--turquesa);

    color: var(--turquesa);
}


/* =====================================================
   PHONE
   ===================================================== */

.hero-phone {

    width: 400px;

    height: 500px;

    display: flex;

    align-items: center;

    justify-content: center;

    position: relative;
}


.phone-glow {

    width: 350px;

    height: 350px;

    background: rgba(18,184,212,.15);

    border-radius: 50%;

    filter: blur(35px);

    position: absolute;
}


.phone {

    width: 215px;

    height: 410px;

    background: #303744;

    border: 7px solid #20252e;

    border-radius: 35px;

    transform: rotate(8deg);

    position: relative;

    box-shadow:

        20px 25px 40px rgba(0,0,0,.2),

        inset 0 0 0 2px #596270;
}


.phone-screen {

    position: absolute;

    inset: 6px;

    border-radius: 27px;

    background:

        radial-gradient(
            circle at 30% 30%,
            #39d8f0,
            #0c6d82 55%,
            #252d39
        );

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    color: white;
}


.phone-screen span {

    font-size: 22px;

    font-weight: 800;

    letter-spacing: 3px;
}


.phone-screen small {

    opacity: .7;
}


.phone-camera {

    position: absolute;

    width: 65px;

    height: 75px;

    background: #171b22;

    border-radius: 17px;

    top: 20px;

    left: 18px;

    z-index: 5;

    padding: 9px;
}


.phone-camera div {

    width: 17px;

    height: 17px;

    background: #343c49;

    border: 3px solid #111;

    border-radius: 50%;

    margin-bottom: 5px;
}


/* =====================================================
   CATEGORIES
   ===================================================== */

.categories {

    display: grid;

    grid-template-columns: repeat(4,1fr);

    gap: 20px;

    padding: 40px 8%;

    background: white;
}


.category {

    padding: 25px;

    border: 1px solid #edf0f2;

    border-radius: 15px;

    transition: .3s;
}


.category:hover {

    transform: translateY(-5px);

    border-color: rgba(18,184,212,.4);

    box-shadow: 0 10px 30px rgba(0,0,0,.05);
}


.category i {

    color: var(--turquesa);

    font-size: 27px;

    margin-bottom: 12px;
}


.category h3 {

    margin-bottom: 5px;
}


.category p {

    color: var(--gris-texto);

    font-size: 14px;
}


/* =====================================================
   SECCIONES
   ===================================================== */

.products-section,
.services,
.contact {

    padding: 100px 8%;
}


.section-title {

    text-align: center;

    max-width: 650px;

    margin: 0 auto 55px;
}


.section-title span,
.about-content > span {

    color: var(--turquesa-dark);

    font-weight: 800;

    letter-spacing: 2px;

    font-size: 13px;
}


.section-title h2 {

    font-size: 42px;

    margin: 8px 0;
}


.section-title p {

    color: var(--gris-texto);
}


/* =====================================================
   PRODUCTOS
   ===================================================== */

.products-section {

    background: var(--gris-claro);
}


.products-grid {

    display: grid;

    grid-template-columns: repeat(4,1fr);

    gap: 25px;
}


.product-card {

    background: white;

    border-radius: 18px;

    overflow: hidden;

    border: 1px solid #e9edef;

    transition: .3s;
}


.product-card:hover {

    transform: translateY(-7px);

    box-shadow: 0 20px 40px rgba(0,0,0,.08);
}


.product-image {

    height: 220px;

    display: flex;

    align-items: center;

    justify-content: center;

    background:

        radial-gradient(
            circle,
            rgba(18,184,212,.18),
            transparent 65%
        );

    font-size: 85px;

    color: var(--turquesa);
}


.product-info {

    padding: 22px;
}


.product-info small {

    color: var(--turquesa-dark);

    font-weight: 700;
}


.product-info h3 {

    margin: 5px 0;
}


.product-info p {

    color: var(--gris-texto);

    font-size: 14px;

    min-height: 48px;
}


.product-bottom {

    margin-top: 20px;

    display: flex;

    justify-content: space-between;

    align-items: center;
}


.product-bottom strong {

    font-size: 20px;
}


.product-bottom button {

    border: none;

    background: var(--turquesa);

    color: white;

    padding: 9px 14px;

    border-radius: 8px;

    cursor: pointer;
}


/* =====================================================
   SERVICIOS
   ===================================================== */

.services-grid {

    display: grid;

    grid-template-columns: repeat(3,1fr);

    gap: 25px;
}


.service {

    padding: 35px;

    border-radius: 18px;

    border: 1px solid #e9edef;

    text-align: center;

    transition: .3s;
}


.service:hover {

    transform: translateY(-5px);

    box-shadow: 0 15px 35px rgba(0,0,0,.06);
}


.service-icon {

    width: 65px;

    height: 65px;

    margin: 0 auto 20px;

    border-radius: 18px;

    background: rgba(18,184,212,.1);

    color: var(--turquesa);

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 28px;
}


.service p {

    color: var(--gris-texto);

    margin-top: 10px;
}


/* =====================================================
   NOSOTROS
   ===================================================== */

.about {

    padding: 100px 8%;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 80px;

    align-items: center;

    background: var(--gris-claro);
}


.about-content h2 {

    font-size: 45px;

    line-height: 1.1;

    margin: 15px 0 25px;
}


.about-content p {

    color: var(--gris-texto);

    margin-bottom: 15px;

    max-width: 550px;
}


.about-content .btn {

    margin-top: 15px;
}


.about-box {

    height: 350px;

    border-radius: 25px;

    background:

        linear-gradient(
            135deg,
            #303744,
            #151a22
        );

    display: flex;

    align-items: center;

    justify-content: center;

    flex-direction: column;

    color: white;

    box-shadow: 20px 20px 0 rgba(18,184,212,.2);
}


.about-logo {

    width: 100px;

    height: 100px;

    border-radius: 30px;

    background: var(--turquesa);

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 50px;

    margin-bottom: 20px;
}


.about-box h3 {

    font-size: 30px;

    letter-spacing: 3px;
}


.about-box p {

    opacity: .7;
}


/* =====================================================
   CONTACTO
   ===================================================== */

.contact {

    background: white;
}


.contact-container {

    max-width: 1000px;

    margin: auto;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 50px;
}


.contact-info {

    display: flex;

    flex-direction: column;

    gap: 25px;
}


.contact-item {

    display: flex;

    align-items: center;

    gap: 18px;
}


.contact-item > i {

    width: 50px;

    height: 50px;

    border-radius: 13px;

    display: flex;

    align-items: center;

    justify-content: center;

    background: rgba(18,184,212,.1);

    color: var(--turquesa);

    font-size: 21px;
}


.contact-item p {

    color: var(--gris-texto);
}


form {

    display: flex;

    flex-direction: column;

    gap: 15px;
}


input,
textarea {

    width: 100%;

    padding: 14px 16px;

    border-radius: 10px;

    border: 1px solid #dfe4e7;

    outline: none;

    font-family: inherit;

    font-size: 15px;
}


input:focus,
textarea:focus {

    border-color: var(--turquesa);

    box-shadow: 0 0 0 3px rgba(18,184,212,.08);
}


textarea {

    resize: vertical;
}


/* =====================================================
   FOOTER
   ===================================================== */

footer {

    padding: 30px 8%;

    background: var(--gris-oscuro);

    color: white;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;
}


.footer-logo {

    color: white;
}


footer p {

    color: #adb3bc;

    font-size: 14px;
}


.social {

    display: flex;

    gap: 10px;
}


.social a {

    width: 38px;

    height: 38px;

    border-radius: 9px;

    display: flex;

    align-items: center;

    justify-content: center;

    color: white;

    background: rgba(255,255,255,.08);

    text-decoration: none;

    transition: .3s;
}


.social a:hover {

    background: var(--turquesa);
}


/* =====================================================
   RESPONSIVE
   ===================================================== */

@media(max-width:1000px) {

    .products-grid {

        grid-template-columns: repeat(2,1fr);
    }

    .categories {

        grid-template-columns: repeat(2,1fr);
    }

    .hero {

        padding-left: 6%;

        padding-right: 6%;
    }

}


@media(max-width:750px) {

    nav {

        display: none;

        position: absolute;

        top: 78px;

        left: 0;

        width: 100%;

        background: white;

        padding: 25px;

        flex-direction: column;

        gap: 20px;

        box-shadow: 0 10px 20px rgba(0,0,0,.08);
    }


    nav.active {

        display: flex;
    }


    .menu-btn {

        display: block;
    }


    .hero {

        flex-direction: column;

        text-align: center;

        padding-top: 60px;
    }


    .hero p {

        margin-left: auto;

        margin-right: auto;
    }


    .hero-buttons {

        justify-content: center;
    }


    .hero-phone {

        width: 100%;

        height: 420px;
    }


    .products-grid,
    .services-grid {

        grid-template-columns: 1fr;
    }


    .categories {

        grid-template-columns: 1fr;
    }


    .about {

        grid-template-columns: 1fr;

        gap: 40px;
    }


    .about-content {

        text-align: center;
    }


    .about-content p {

        margin-left: auto;

        margin-right: auto;
    }


    .contact-container {

        grid-template-columns: 1fr;
    }


    footer {

        flex-direction: column;

        text-align: center;
    }

}


@media(max-width:450px) {

    .hero h1 {

        font-size: 48px;
    }


    .section-title h2 {

        font-size: 34px;
    }


    .hero-buttons {

        flex-direction: column;
    }


    .hero-buttons .btn {

        width: 100%;
    }

}
